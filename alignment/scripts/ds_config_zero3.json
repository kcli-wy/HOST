{
    "fp16": {
        "enabled": false,
        "loss_scale": 0,
        "loss_scale_window": 1000,
        "initial_scale_power": 16,
        "hysteresis": 2,
        "min_loss_scale": 1
    },
    "bf16": {
        "enabled": true
    },
    "zero_optimization": {
        "stage": 3,
        "allgather_partitions": true,
        "allgather_bucket_size": 20000000,
        "overlap_comm": false,
        "reduce_scatter": true,
        "reduce_bucket_size": 20000000,
        "contiguous_gradients": true,
        "stage3_prefetch_bucket_size": 10000000,
        "stage3_param_persistence_threshold": 10000,
        "stage3_max_live_parameters": 100000000,
        "stage3_max_reuse_distance": 100000000,
        "sub_group_size": 100000000,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "stage3_gather_16bit_weights_on_model_save": false
    },
    "train_micro_batch_size_per_gpu": 4,
    "gradient_accumulation_steps": 8,
    "steps_per_print": 10,
    "wall_clock_breakdown": false
}
